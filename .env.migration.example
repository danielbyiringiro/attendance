# Copy to .env.migration to run the app against a DIFFERENT project without
# touching .env.local:
#
#   npm run dev:mig
#
# That command refuses to start unless .env.migration exists, so it can never
# quietly fall back to the everyday project — which is the one mistake this
# mode exists to prevent.
#
# Its use is trying a second project for real before anything depends on it:
# sign in, take a register, check a month, with the same code the live site
# runs. .env.migration itself is gitignored; only this example is tracked.

VITE_SUPABASE_URL=https://the-other-project-ref.supabase.co

# The anon / publishable key of that project. Never the service_role key.
VITE_SUPABASE_ANON_KEY=its-anon-key
