# Copy this file to .env.local for local development. .env.local is gitignored.
#
# On the host (Vercel), set these two in the project's environment variables
# instead. Vite inlines them at BUILD time, so a change only takes effect on the
# next deploy — setting a variable and waiting does nothing. A build with either
# one missing fails on purpose, and a failed build leaves the live site as it was.
#
# Both values are in the Supabase dashboard under Project Settings > API.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The anon / publishable key, and only ever that one. It is safe in a browser
# because row-level security is enabled on every table and every student-facing
# path goes through a SECURITY DEFINER function. The service_role key is NOT safe
# here: it bypasses row-level security entirely.
VITE_SUPABASE_ANON_KEY=your-anon-key
